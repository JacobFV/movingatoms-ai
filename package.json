{
  "name": "movingatoms-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2026-10-01",
    "dev:realtime": "wrangler dev -c workers/realtime/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply movingatoms --remote",
    "db:migrate:local": "wrangler d1 migrations apply movingatoms --local",
    "deploy:realtime": "wrangler deploy -c workers/realtime/wrangler.toml",
    "deploy:pages": "wrangler pages deploy public --project-name movingatoms-ai --branch main --force",
    "deploy": "npm run deploy:realtime && npm run db:migrate && npm run deploy:pages",
    "media:sync": "node scripts/media-sync.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@cloudflare/containers": "^0.3.7",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.40.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
